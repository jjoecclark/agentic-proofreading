# Apptainer recipe for the sandbox that runs generated harnesses and the meta-agent.
# Build (on della-vis1):  apptainer build outer/sandbox.sif outer/sandbox.def
# The image holds only public packages. No secrets, no project data: those are bound in at
# run time by outer/sandbox.py, and only the paths PLAN.md Section 7 allows.
Bootstrap: docker
From: python:3.12-slim

%labels
    sandbox_image_version 1

%post
    export PIP_NO_CACHE_DIR=1
    pip install --no-cache-dir \
        numpy scipy scikit-image pillow matplotlib networkx trimesh pyyaml \
        anthropic claude-agent-sdk
    # The Claude Agent SDK wheel bundles the Claude Code CLI; fail the build if it is missing.
    python -c "import claude_agent_sdk, pathlib; p = pathlib.Path(claude_agent_sdk.__file__).parent / '_bundled'; assert any(p.iterdir()), p"

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export MPLBACKEND=Agg
    export DISABLE_AUTOUPDATER=1
    export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    export DISABLE_TELEMETRY=1
    export DISABLE_ERROR_REPORTING=1
